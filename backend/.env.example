# CleanPlate AI Backend Environment Variables
APP_NAME=CleanPlate AI API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081,exp://*

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Vision Service Configuration
# Set to 'gemini' for live Gemini Vision API, or 'demo' for deterministic mock analysis
AI_VISION_ADAPTER=demo
GEMINI_API_KEY=
VISION_MODEL_NAME=gemini-1.5-flash
